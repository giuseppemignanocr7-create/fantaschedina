# Firebase Web SDK config
# Crea un progetto su https://console.firebase.google.com
# Project Settings -> General -> Your apps -> Web -> SDK setup
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (opzionale ma raccomandato in produzione)
# reCAPTCHA Enterprise site key. Senza questa, App Check resta disattivato
# e le callable NON possono essere messe in enforcement.
# Procedura: docs/runbook/app-check.md
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Error tracking (opzionale). Senza DSN il monitoring resta inerte.
# Procedura: docs/runbook/osservabilita.md
VITE_SENTRY_DSN=
VITE_APP_VERSION=

# Test E2E locali: usa gli emulatori Firebase invece del progetto reale.
# Attivo solo in DEV, mai in produzione.
VITE_USE_FIREBASE_EMULATORS=false
