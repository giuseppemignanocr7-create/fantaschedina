rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // Stesso formato di src/lib/username.ts (USERNAME_RE).
    function validUsername(value) {
      return value is string && value.matches('^[A-Za-z0-9_.]{3,20}$');
    }

    // Lo username e' prenotato a nome di questo utente in /usernames, con
    // chiave in minuscolo: e' cio' che lo rende unico senza badare alle
    // maiuscole. La prenotazione si scrive nello stesso batch del profilo.
    function usernameRiservato(uid, value) {
      return validUsername(value)
        && existsAfter(/databases/$(database)/documents/usernames/$(value.lower()))
        && getAfter(/databases/$(database)/documents/usernames/$(value.lower())).data.uid == uid;
    }

    // Cambiando nome, la prenotazione del vecchio (se era sua) va liberata
    // nello stesso batch: niente accaparramento di nomi.
    function vecchioUsernameLiberato(uid, vecchio, nuovo) {
      return !validUsername(vecchio)
        || vecchio.lower() == nuovo.lower()
        || !exists(/databases/$(database)/documents/usernames/$(vecchio.lower()))
        || get(/databases/$(database)/documents/usernames/$(vecchio.lower())).data.uid != uid
        || !existsAfter(/databases/$(database)/documents/usernames/$(vecchio.lower()));
    }

    // L'app non carica avatar propri: al piu' la foto dell'account Google.
    function validAvatar(value) {
      return value == null
        || (value is string && value.size() <= 2048
            && value.matches('^https://lh[0-9]\\.googleusercontent\\.com/[A-Za-z0-9_\\-/=.]+$'));
    }

    // Solo le categorie note (functions/src/notify.ts), solo booleani.
    function validNotifPrefs(p) {
      return p is map
        && p.keys().hasOnly(['schedina', 'giro', 'live', 'esito', 'social'])
        && (!('schedina' in p) || p.schedina is bool)
        && (!('giro' in p) || p.giro is bool)
        && (!('live' in p) || p.live is bool)
        && (!('esito' in p) || p.esito is bool)
        && (!('social' in p) || p.social is bool);
    }

    // ============================================
    // PROFILES
    // Punti, gettoni e statistiche sono scritti SOLO dalle Cloud Functions
    // (Admin SDK bypassa le rules). L'utente può modificare solo
    // username / avatarUrl / updatedAt.
    // ============================================
    match /profiles/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'id', 'username', 'email', 'avatarUrl', 'totalPoints', 'weeklyPoints',
          'matchdaysPlayed', 'perfectSchedine', 'bonusPointsTotal',
          'penaltyPointsTotal', 'weeklyWins', 'bestMatchdayPoints',
          'correctPredictions', 'paidWeeks', 'joinedMatchday', 'isActive',
          'coins', 'coinsEarned', 'claimedMissions', 'leaguesJoined',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.id == uid
        && request.auth.token.email is string
        && request.resource.data.email == request.auth.token.email
        && usernameRiservato(uid, request.resource.data.username)
        && request.resource.data.avatarUrl == null
        && request.resource.data.totalPoints == 0
        && request.resource.data.weeklyPoints == 0
        && request.resource.data.matchdaysPlayed == 0
        && request.resource.data.perfectSchedine == 0
        && request.resource.data.bonusPointsTotal == 0
        && request.resource.data.penaltyPointsTotal == 0
        && request.resource.data.weeklyWins == 0
        && request.resource.data.bestMatchdayPoints == 0
        && request.resource.data.correctPredictions == 0
        && request.resource.data.paidWeeks == 0
        && request.resource.data.joinedMatchday == 1
        && request.resource.data.isActive == true
        && request.resource.data.coins == 100
        && request.resource.data.coinsEarned == 0
        && request.resource.data.claimedMissions == []
        && request.resource.data.leaguesJoined == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      // Ogni campo si valida solo se cambia: i profili nati prima delle
      // regole attuali (username con spazi, per esempio) devono poter ancora
      // salvare le preferenze senza essere costretti a rinominarsi.
      allow update: if isOwner(uid)
        // Un utente bannato non puo' piu' cambiare nome o foto.
        && resource.data.get('isActive', true) != false
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['username', 'avatarUrl', 'notifPrefs', 'updatedAt'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['username'])
            || (usernameRiservato(uid, request.resource.data.username)
                && vecchioUsernameLiberato(uid, resource.data.username, request.resource.data.username)))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['avatarUrl'])
            || validAvatar(request.resource.data.avatarUrl))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['notifPrefs'])
            || validNotifPrefs(request.resource.data.notifPrefs))
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // ============================================
    // MATCHDAYS — sola lettura. Creazione/risultati/odds
    // gestiti dalle Cloud Functions (syncMatchday / settleMatchdays).
    // ============================================
    match /matchdays/{number} {
      allow read: if isAuth();
      allow write: if false;
    }

    // ============================================
    // SCHEDINE — scritte SOLO dalla callable submitSchedina.
    // Le schedine altrui sono leggibili solo DOPO la deadline
    // della giornata (anti-copia).
    // ============================================
    // ============================================
    // PUSH TOKENS — un doc per dispositivo, id = token FCM.
    // L'utente registra e cancella i propri; le Cloud Functions li leggono
    // per inviare (Admin SDK) e cancellano quelli non piu' validi.
    // ============================================
    match /push_tokens/{token} {
      allow get: if isAuth() && resource.data.uid == request.auth.uid;
      allow list: if false;
      // Il token di un altro non si riscrive a proprio nome: chi conosce
      // l'id (il token) potrebbe altrimenti dirottare le sue notifiche.
      allow create: if isAuth()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'createdAt', 'ua'])
        && request.resource.data.ua is string
        && request.resource.data.ua.size() <= 120;
      allow update: if isAuth()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'createdAt', 'ua'])
        && request.resource.data.ua is string
        && request.resource.data.ua.size() <= 120;
      allow delete: if isAuth() && resource.data.uid == request.auth.uid;
    }

    // ============================================
    // USERNAMES — prenotazione dei nomi, id = username in minuscolo.
    // Si crea e si libera solo insieme al profilo (stesso batch): e' cio' che
    // rende lo username unico senza badare alle maiuscole.
    // ============================================
    match /usernames/{name} {
      allow get: if isAuth();
      allow list: if false;
      allow create: if isAuth()
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && name.matches('^[a-z0-9_.]{3,20}$')
        && getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.username.lower() == name;
      allow update: if false;
      allow delete: if isAuth()
        && resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.username.lower() != name;
    }

    match /schedine/{id} {
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        resource.data.settled == true ||
        request.time > get(/databases/$(database)/documents/matchdays/$(string(resource.data.matchdayNumber))).data.deadline
      );
      allow write: if false;
    }

    // ============================================
    // LEAGUES — CRUD lato client con vincoli.
    // ============================================
    match /leagues/{leagueId} {
      allow read: if isAuth() && (
        resource.data.isPrivate == false ||
        request.auth.uid in resource.data.memberIds
      );
      allow write: if false;

      // Classifica di lega: scritta dal settlement, letta solo tramite la
      // callable getRankings, che controlla se la lega è visibile a chi chiede.
      match /standings/{uid} {
        allow read, write: if false;
      }
    }

    // ============================================
    // WALLET TRANSACTIONS — audit trail, scritte solo dalle Functions.
    // ============================================
    match /wallet_transactions/{txId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // ============================================
    // PRIZES — storico premi, scritti dalle Functions.
    // ============================================
    match /prizes/{prizeId} {
      allow read: if isAuth();
      allow write: if false;
    }

    // ============================================
    // WEEKLY PRIZES — cosa si vince in una data giornata. Li decide l'admin
    // (adminManageWeeklyPrizes) e devono essere visibili a chi gioca.
    // ============================================
    // ============================================
    // ESTRAZIONE DI GIORNATA — stato pubblico e biglietti personali.
    // Scrive solo il server (callable buyRaffleTicket, sorteggio al settlement).
    // ============================================
    match /raffles/{matchday} {
      allow read: if isAuth();
      allow write: if false;
    }

    match /raffle_tickets/{id} {
      allow get: if isAuth() && resource.data.uid == request.auth.uid;
      allow list: if false;
      allow write: if false;
    }

    // ============================================
    // CASELLA NOTIFICHE — una copia di ogni avviso inviato come push.
    // Scrive solo il server; l'utente legge le sue, le segna lette, le cancella.
    // ============================================
    match /notifications/{uid}/items/{id} {
      allow read: if isOwner(uid);
      allow create: if false;
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt'])
        && request.resource.data.read == true;
      allow delete: if isOwner(uid);
    }

    match /weekly_prizes/{matchday} {
      allow read: if isAuth();
      allow write: if false;
    }

    function isAdmin() {
      return isAuth() && exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'admin';
    }

    // ============================================
    // QUIZ QUESTIONS — pool domande (seed via console/admin).
    // ============================================
    match /quiz_questions/{qId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /quiz_sessions/{uid} {
      allow read, write: if false;
    }

    // Sessioni di memoria e rigori: solo le Cloud Functions.
    match /minigame_sessions/{id} {
      allow read, write: if false;
    }

    // ============================================
    // PENALTY DUELS — stato partita realtime.
    // Scritto solo dalle Cloud Functions, letto dai giocatori.
    // ============================================
    match /penalty_duels/{duelId} {
      allow read: if isAuth() && (
        resource.data.p1.uid == request.auth.uid ||
        resource.data.p2.uid == request.auth.uid
      );
      allow write: if false;
    }

    // Mosse del round in corso: restano nascoste a entrambi i giocatori
    // finché il server non risolve il round (poi appare `lastRound` sopra).
    match /penalty_duel_moves/{duelId} {
      allow read, write: if false;
    }

    // ============================================
    // SPONSORS — gestiti da admin via Cloud Functions.
    // ============================================
    match /sponsors/{sponsorId} {
      allow read: if isAuth();
      allow write: if false;
    }

    // ============================================
    // RATE LIMITS — scritti solo dalle Cloud Functions.
    // ============================================
    match /rate_limits/{docId} {
      allow read, write: if false;
    }

    // ============================================
    // CONFIG — campionati attivi e altre config globali,
    // gestite da admin via Cloud Functions (adminManageCompetitions).
    // ============================================
    match /config/{docId} {
      allow read: if isAuth();
      allow write: if false;
    }
  }
}
